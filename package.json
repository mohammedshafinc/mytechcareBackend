{
  "name": "mytechcare-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src/worker src/worker.ts tests --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:smoke": "vitest run tests/smoke",
    "test:docs": "vitest run tests/unit/docs.test.ts",
    "config:ci": "node scripts/create-ci-wrangler-config.mjs",
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler-dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "benchmark:password": "node --import tsx scripts/benchmark-password.ts",
    "validate:ci": "npm run typecheck && npm run build && npm run lint && npm test -- --run && npm run config:ci && npm run db:migrate:local -- --config .wrangler-ci.jsonc && npm run deploy:dry-run -- --config .wrangler-ci.jsonc"
  },
  "dependencies": {
    "fast-xml-parser": "5.5.9",
    "hono": "4.9.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.66",
    "@cloudflare/workers-types": "4.20250906.0",
    "@eslint/js": "9.18.0",
    "eslint": "9.18.0",
    "globals": "16.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "3.2.4",
    "wrangler": "4.35.0"
  }
}
